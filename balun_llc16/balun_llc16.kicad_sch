	(text "1. J1: MB12MBAFF08ST-3, male, B-side. Sourcing / panel support on HOLD."
        (exclude_from_sim no) (at 20.32 162.56 0)
        (effects (font  (size 1.5 1.5) ) (justify left))
        (uuid "85faa622-8363-5fd1-a901-35f0b1cfd4de")
    )
	(text "2. J1.1/5/6/7 are NC. Never connect cable N24 to VNA GND."
        (exclude_from_sim no) (at 20.32 167.64 0)
        (effects (font  (size 1.5 1.5) ) (justify left))
        (uuid "e16328da-8ff0-5784-a33a-03e7a709446a")
    )
	(text "3. RCT1/RCT2: 0R, DNP. Keep both CTs floating. No on-board 100 ohm load."
        (exclude_from_sim no) (at 20.32 172.72 0)
        (effects (font  (size 1.5 1.5) ) (justify left))
        (uuid "b654b812-8613-5bfb-ba2f-f7d661ce52fc")
    )
	(text "4. Use existing RJ45 A/B fixture; terminate all four unused SMA ports."
        (exclude_from_sim no) (at 20.32 177.8 0)
        (effects (font  (size 1.5 1.5) ) (justify left))
        (uuid "b148aee0-11bf-56a0-a16a-d6ba443105cb")
    )
	(text "5. Coax O/S/L + THRU calibration does not remove the baluns or PCB."
        (exclude_from_sim no) (at 20.32 182.88 0)
        (effects (font  (size 1.5 1.5) ) (justify left))
        (uuid "f90287df-4d16-563e-b933-9bb622f5f78e")
    )
	(text "6. Unpowered DUT only. Check cable wiring before first VNA connection."
        (exclude_from_sim no) (at 20.32 187.96 0)
        (effects (font  (size 1.5 1.5) ) (justify left))
        (uuid "8adf719b-3817-53e9-aac9-38a692ccf0c0")
    )
